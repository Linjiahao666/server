# HTTP
HTTP_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://store:store@postgres:5432/store?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=store
MINIO_USE_SSL=false

# JWT RS256 keys in PEM format. Leave empty to auto-generate ephemeral keys for local dev.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
