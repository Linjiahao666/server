# HTTP
HOST_PORT=8080
HTTP_PORT=8080

# PostgreSQL
POSTGRES_USER=store
POSTGRES_PASSWORD=store
POSTGRES_DB=store
DATABASE_URL=postgres://store:store@postgres:5432/store?sslmode=disable

# Redis is published only on the host loopback address.
REDIS_HOST_PORT=6379
REDIS_PASSWORD=store
REDIS_URL=redis://:store@redis:6379/0

# Auth rate limits per client IP in a 60 second window.
RATE_LIMIT_REGISTER=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REFRESH=30

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_HOST_BIND=0.0.0.0
MINIO_HOST_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=store
MINIO_USE_SSL=false

# JWT RS256 keys in PEM format. Leave empty to auto-generate ephemeral keys for local dev.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
